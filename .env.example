# Routing Config is visible by default. Set to false to hide it if needed.
VITE_ENABLE_ADMIN_MENUS=true

# customer: customer demo menus/routes only.
# local: customer demo plus local-only modules such as Design System and Employee Management.
VITE_APP_VISIBILITY_PROFILE=customer

# Local-maintainer only: exposes the legacy Contact Management demo. Customer
# profiles always keep CRM contacts read-only.
VITE_ENABLE_CONTACT_EDIT=false
