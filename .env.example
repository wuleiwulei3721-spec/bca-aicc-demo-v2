# Routing Config is visible by default. Set to false to hide it if needed.
VITE_ENABLE_ADMIN_MENUS=true

# customer: customer demo menus/routes only.
# local: customer demo plus local-only modules such as Design System and Employee Management.
VITE_APP_VISIBILITY_PROFILE=customer

# Local-maintainer only: exposes the legacy Contact Management demo. Customer
# profiles always keep CRM contacts read-only.
VITE_ENABLE_CONTACT_EDIT=false

# Common Phrase runtime mode.
# Leave unset: development uses the local FastAPI + MySQL API by default;
# production builds use in-browser demo data so customer deployments do not call localhost.
# Set to demo for a static/mock build that must not call a backend.
# VITE_COMMON_PHRASE_MODE=

# Common Number runtime mode. It follows the same local FastAPI / customer demo
# boundary, but remains an independent switch so it cannot change Common Phrase.
# Leave unset: development uses the local API; production uses bundled demo data.
# VITE_COMMON_NUMBER_MODE=

# Common Link runtime mode. It follows the same local FastAPI / customer demo
# boundary and is independent from Common Phrase and Common Number.
# Leave unset: development uses the local API; production uses bundled demo data.
# VITE_COMMON_LINK_MODE=

# Local API implementation used by Vite's /api proxy.
# fastapi: Python FastAPI + local MySQL (default for local development).
# node: retained legacy rollback implementation; do not use for the normal workflow.
# VITE_COMMON_PHRASE_BACKEND=fastapi
# VITE_COMMON_PHRASE_BACKEND_URL=http://127.0.0.1:8000
