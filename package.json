{
  "name": "bca-aicc-demo-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "backend:install": "node scripts/run-backend-python.mjs -m pip install -r backend/requirements.txt",
    "backend:migrate": "node scripts/run-backend-python.mjs backend/scripts/migrate.py",
    "backend:test": "node scripts/run-backend-python.mjs -m pytest backend/tests",
    "check:local": "node scripts/check-local.mjs",
    "check:fastapi": "node scripts/check-fastapi.mjs",
    "db:inspect": "node scripts/inspect-common-phrases.mjs",
    "db:mysql-schema": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/inspect-mysql-schema.ps1",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --experimental-strip-types server/index.ts",
    "dev:fastapi": "node scripts/run-backend-python.mjs backend/run.py",
    "dev:frontend": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test server/commonPhraseRepository.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "antd": "^6.4.2",
    "dayjs": "^1.11.21",
    "less": "^4.6.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "mysql2": "^3.24.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
